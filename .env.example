# Example configuration for the stories project
MAIL_FROM=admin@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=secret
SMTP_SECURE=tls

# WallyAuth SSO Configuration
WALLYAUTH_ISSUER=https://auth.wallyatkins.com
WALLYAUTH_CLIENT_ID=stories
WALLYAUTH_CLIENT_SECRET=
WALLYAUTH_REDIRECT_URI=https://stories.wallyatkins.com/api/oauth_callback.php

# Database connection for whitelist and friends
DB_DSN=pgsql:host=localhost;port=5432;dbname=stories
DB_USER=stories
DB_PASS=password

# Shared secret that authorizes the processing pipeline when it calls back
# Generate with: openssl rand -hex 32
PIPELINE_API_TOKEN=
